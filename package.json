{
  "name": "folded-scroll-edges",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:worker": "node scripts/build-pages-worker.mjs",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "verify:deploy-local": "node scripts/verify-deploy-local.mjs",
    "record:artifacts": "node scripts/record-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "playwright": "^1.51.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "4.158.0"
  }
}
